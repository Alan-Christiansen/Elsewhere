{
  "name": "obsidian-url-note",
  "version": "0.1.0",
  "description": "Create and edit .url Internet Shortcut files without leaving Obsidian.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "tsc --noEmit --skipLibCheck && node --test tests/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "url",
    "shortcut"
  ],
  "author": "Spectra Studio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
